# Forge V2 — example environment (placeholders only; never put real secrets here)
# Copy to .env, then UNCOMMENT and fill ONLY the vars your task actually uses.
# IMPORTANT (fix 2026-07-09 checkup): the commented lines below are INERT on purpose — an uncommented
# placeholder like NVIDIA_API_KEY=__set_in_env__ would be loaded as a real value and override a valid
# global ~/.claude/nvidia.env key (project .env wins), and the NVIDIA_*_MODEL placeholders would override
# every role's real model with a bogus id. Leave them commented until you put a REAL value.

# Generic app (safe defaults — fine to keep active)
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# LLM / AI-RAG (provider-agnostic; uncomment + fill only what the task uses)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VECTOR_DB_URL=

# Database
# DATABASE_URL=

# Telegram bot
# TELEGRAM_BOT_TOKEN=

# n8n / automation / webhooks
# N8N_WEBHOOK_URL=
# WEBHOOK_SIGNING_SECRET=

# External APIs / integrations
# THIRD_PARTY_API_KEY=

# NVIDIA Build / NIM (OpenAI-compatible; key starts with "nvapi-", generate at build.nvidia.com/settings/api-keys)
# REAL key goes ONLY in your local .env (git-ignored) or global ~/.claude/nvidia.env — never here, never in code/logs.
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL defaults to https://integrate.api.nvidia.com/v1 — only set to override.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Per-role model overrides — the real defaults live in config/models/model-capability-matrix.json.
# Only set these to force a specific model; an unknown id is rejected/warned by nvidia-provider.
# NVIDIA_DEFAULT_MODEL=
# NVIDIA_REASONING_MODEL=
# NVIDIA_REVIEW_MODEL=
# NVIDIA_CODING_MODEL=
# NVIDIA_CODING_FAST_MODEL=
# NVIDIA_FAST_MODEL=
# NVIDIA_VISION_MODEL=

# Forge strict event logging is ON by default; set to 0 only for soft debugging (not recommended).
# FORGE_STRICT_EVENTS=0

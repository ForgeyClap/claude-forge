# Forge Discord canary — voorbeeldconfiguratie. Kopieer naar .env en vul in.
# NOOIT een echt token in dit bestand of in git zetten.

# mock = lokaal testen zonder Discord; discord = echte verbinding (owner-gated)
TRANSPORT=mock

# Discord bot (alleen nodig bij TRANSPORT=discord)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Comma-gescheiden Discord user-ID's die prompts mogen sturen (owner allowlist)
OWNER_USER_IDS=

# Queue-beleid
EXPIRY_HOURS=2
MAX_QUEUED_PER_THREAD=10
GLOBAL_MAX_ACTIVE_RUNS=2

# Waar duurzame state (queue, mappings, outbox, audit) wordt opgeslagen
STATE_DIR=./state

# Runner: fake (echo, veilig testen) of claude (echte headless Claude Code-runs)
RUNNER=fake

# Map met projecten die automatisch een eigen kanaal krijgen (auto-sync elke 60s)
FORGE_PROJECTS_DIR=C:\Users\YOU\Documents\ForgeProjects

# Lokale poorten (alleen 127.0.0.1): status-API van de bot + dashboard-tab
BOT_HTTP_PORT=3979
MANAGER_PORT=3987

# Chat elke X minuten opruimen (transcript wordt bewaard). 0 = uit.
CHAT_RESET_MINUTES=30

# Auto-pauze bij hoog verbruik (voorkomt vastlopen halverwege een run).
PAUSE_AT_PERCENT=90
RESUME_AT_PERCENT=80

# Dagplafond in dollars (0 = uit).
DAILY_COST_LIMIT_USD=0

# Uur voor de ochtendbriefing. -1 = uit.
BRIEFING_HOUR=8

# Optioneel: pad naar een spraak-naar-tekst-tool voor spraakmemo's.
# Leeg = automatisch zoeken naar whisper/whisper-cli/faster-whisper in PATH.
TRANSCRIBE_BIN=

# Optionele webhook voor meldingen buiten de bot om. Dit is een GEHEIM.
OWNER_WEBHOOK_URL=

{
  "$meta": {
    "name": "Forge",
    "version": "2.8.0",
    "prefix": "forge",
    "softAlpha": 0.16,
    "lineAlpha": 0.4,
    "note": "Single source of truth. Edit this file, then run: node brand/build-theme.cjs"
  },

  "palette": {
    "_comment": "Raw material scale. NOT emitted to CSS - only referenced by the semantic layer below via {palette.x.y} aliases.",

    "iron": {
      "_comment": "The monochrome spine. Cool neutral grey, black through white. Every surface, line and text value resolves here.",
      "1000": "#000000",
      "975": "#06080A",
      "950": "#0B0E11",
      "900": "#101418",
      "850": "#151A1F",
      "800": "#1B2127",
      "750": "#1F262C",
      "700": "#242C33",
      "650": "#2A333A",
      "600": "#303941",
      "550": "#39424B",
      "500": "#414C56",
      "450": "#4E5A65",
      "400": "#5A6672",
      "350": "#6B7783",
      "300": "#7C8894",
      "250": "#8E9AA6",
      "200": "#A3AEB9",
      "150": "#B6C0C9",
      "100": "#C8D0D8",
      "75": "#D8DFE5",
      "50": "#E6EBEF",
      "35": "#EDF1F4",
      "25": "#F3F6F8",
      "15": "#F8FAFB",
      "0": "#FFFFFF"
    },

    "ember": {
      "_comment": "The Forge accent. Deliberately rationed - focus rings, the active control, running progress. Never a surface, never a fill at scale.",
      "900": "#4A1A06",
      "800": "#6B2708",
      "700": "#9A3A0C",
      "600": "#C85312",
      "500": "#F5732A",
      "400": "#FF9354",
      "300": "#FFB585",
      "200": "#FFD3B8",
      "100": "#FFEADD"
    },

    "_legacy": {
      "_comment": "Chromatic scales from theme v1. Kept for reference only - the v2 semantic layer no longer maps status or group identity onto hue.",
      "patina": { "700": "#1F6A4F", "500": "#46B58C" },
      "quench": { "700": "#13707F", "500": "#35BFD6" },
      "steel": { "700": "#2E5488", "500": "#5B8FD6" },
      "slag": { "700": "#8F2727", "500": "#E05252" },
      "brass": { "700": "#8A6320", "500": "#D9A441" }
    }
  },

  "global": {
    "font": {
      "sans": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI Variable Text', 'Segoe UI', Inter, Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, 'Cascadia Code', 'Cascadia Mono', 'JetBrains Mono', 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    },

    "text": {
      "2xs": "0.6875rem",
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "base": "0.875rem",
      "md": "0.9375rem",
      "lg": "1.0625rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.375rem"
    },

    "leading": {
      "none": "1",
      "tight": "1.2",
      "snug": "1.35",
      "normal": "1.55",
      "relaxed": "1.7"
    },

    "tracking": {
      "tight": "-0.011em",
      "normal": "0",
      "wide": "0.02em",
      "eyebrow": "0.08em"
    },

    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },

    "space": {
      "0": "0",
      "px": "1px",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem"
    },

    "radius": {
      "xs": "3px",
      "sm": "5px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "2xl": "22px",
      "full": "999px"
    },

    "border": {
      "hair": "1px",
      "thick": "2px"
    },

    "control": {
      "_comment": "Every interactive control snaps to one of these heights. Consistency here is most of what separates a product from a component demo.",
      "xs": "22px",
      "sm": "26px",
      "md": "30px",
      "lg": "36px",
      "xl": "42px"
    },

    "icon": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "24px"
    },

    "motion": {
      "instant": "0ms",
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms",
      "slower": "520ms",
      "ease-standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "ease-enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "ease-exit": "cubic-bezier(0.4, 0, 1, 1)"
    },

    "z": {
      "base": "0",
      "sticky": "100",
      "dock": "200",
      "overlay": "300",
      "modal": "400",
      "toast": "500",
      "tooltip": "600"
    },

    "layout": {
      "sidebar": "264px",
      "sidebar-collapsed": "60px",
      "rail": "48px",
      "inspector": "340px",
      "header": "52px",
      "dock": "260px",
      "dock-collapsed": "34px",
      "reading": "46rem",
      "composer": "46rem",
      "minimap-w": "168px",
      "minimap-h": "112px",
      "node-w": "188px",
      "node-h": "62px",
      "lane-gap": "26px",
      "col-gap": "78px"
    }
  },

  "modes": {
    "dark": {
      "_comment": "Near-black canvas, layered graphite panels. Hue appears only in the rationed ember accent.",

      "color": {
        "canvas": "{palette.iron.975}",
        "bg": "{palette.iron.950}",
        "surface-1": "{palette.iron.900}",
        "surface-2": "{palette.iron.850}",
        "surface-3": "{palette.iron.800}",
        "raised": "{palette.iron.800}",
        "sunken": "{palette.iron.1000}",
        "overlay": "rgba(6, 8, 10, 0.74)",
        "scrim": "rgba(6, 8, 10, 0.55)",

        "line-subtle": "{palette.iron.800}",
        "line": "{palette.iron.700}",
        "line-strong": "{palette.iron.550}",
        "line-loud": "{palette.iron.400}",

        "text": "{palette.iron.25}",
        "text-secondary": "{palette.iron.150}",
        "text-muted": "{palette.iron.300}",
        "text-faint": "{palette.iron.400}",
        "text-on-accent": "{palette.iron.975}",
        "text-inverse": "{palette.iron.950}",

        "hover": "rgba(255, 255, 255, 0.045)",
        "active": "rgba(255, 255, 255, 0.075)",
        "selected": "rgba(255, 255, 255, 0.095)",

        "_solid-note": "The primary control is an INVERTED SURFACE, not an accent fill. A solid ember button would make the accent the loudest thing on every screen, which is exactly what the monochrome direction forbids.",
        "solid": "{palette.iron.25}",
        "solid-hover": "{palette.iron.0}",
        "solid-active": "{palette.iron.75}",
        "solid-text": "{palette.iron.975}",

        "accent": "{palette.ember.500}",
        "accent-hover": "{palette.ember.400}",
        "accent-active": "{palette.ember.600}",
        "accent-quiet": "{palette.ember.300}",

        "focus": "{palette.ember.400}",
        "selection": "rgba(245, 115, 42, 0.26)",

        "scrollbar": "{palette.iron.700}",
        "scrollbar-hover": "{palette.iron.550}"
      },

      "status": {
        "_comment": "Grey value carries weight, not meaning. The -style and -width companions let a component signal state through border treatment, so nothing depends on colour alone.",

        "running": "{palette.iron.15}",
        "running-style": "solid",
        "running-width": "{global.border.thick}",

        "completed": "{palette.iron.100}",
        "completed-style": "solid",
        "completed-width": "{global.border.hair}",

        "verify": "{palette.iron.200}",
        "verify-style": "solid",
        "verify-width": "{global.border.hair}",

        "review": "{palette.iron.250}",
        "review-style": "dashed",
        "review-width": "{global.border.hair}",

        "waiting": "{palette.iron.350}",
        "waiting-style": "dashed",
        "waiting-width": "{global.border.hair}",

        "blocked": "{palette.iron.450}",
        "blocked-style": "dotted",
        "blocked-width": "{global.border.hair}",

        "failed": "{palette.iron.0}",
        "failed-style": "solid",
        "failed-width": "{global.border.thick}",

        "previewing": "{palette.iron.200}",
        "previewing-style": "dashed",
        "previewing-width": "{global.border.hair}",

        "internal": "{palette.iron.450}",
        "internal-style": "dotted",
        "internal-width": "{global.border.hair}"
      },

      "group": {
        "_comment": "Seven agent groups, seven luminance steps. Identity is reinforced by icon and label in the component layer.",
        "control": "{palette.iron.35}",
        "context": "{palette.iron.100}",
        "planning": "{palette.iron.150}",
        "domain": "{palette.iron.250}",
        "execution": "{palette.iron.300}",
        "review": "{palette.iron.400}",
        "memory": "{palette.iron.500}"
      },

      "shadow": {
        "sm": "0 1px 2px rgba(0, 0, 0, 0.5)",
        "md": "0 4px 14px rgba(0, 0, 0, 0.5)",
        "lg": "0 18px 44px rgba(0, 0, 0, 0.62)",
        "inset": "inset 0 1px 0 rgba(255, 255, 255, 0.035)",
        "focus-ring": "0 0 0 2px #06080A, 0 0 0 4px rgba(255, 147, 84, 0.85)"
      }
    },

    "light": {
      "_comment": "Neutral off-white canvas with layered light-grey panels. Panels never dissolve into the page - every surface keeps a precise border.",

      "color": {
        "canvas": "{palette.iron.50}",
        "bg": "{palette.iron.35}",
        "surface-1": "{palette.iron.0}",
        "surface-2": "{palette.iron.15}",
        "surface-3": "{palette.iron.25}",
        "raised": "{palette.iron.0}",
        "sunken": "{palette.iron.50}",
        "overlay": "rgba(16, 20, 24, 0.42)",
        "scrim": "rgba(16, 20, 24, 0.28)",

        "line-subtle": "{palette.iron.50}",
        "line": "{palette.iron.100}",
        "line-strong": "{palette.iron.150}",
        "line-loud": "{palette.iron.250}",

        "text": "{palette.iron.900}",
        "text-secondary": "{palette.iron.550}",
        "text-muted": "{palette.iron.400}",
        "text-faint": "{palette.iron.350}",
        "text-on-accent": "{palette.iron.0}",
        "text-inverse": "{palette.iron.25}",

        "hover": "rgba(16, 20, 24, 0.04)",
        "active": "rgba(16, 20, 24, 0.07)",
        "selected": "rgba(16, 20, 24, 0.085)",

        "solid": "{palette.iron.900}",
        "solid-hover": "{palette.iron.950}",
        "solid-active": "{palette.iron.1000}",
        "solid-text": "{palette.iron.0}",

        "accent": "{palette.ember.700}",
        "accent-hover": "{palette.ember.600}",
        "accent-active": "{palette.ember.800}",
        "accent-quiet": "{palette.ember.700}",

        "focus": "{palette.ember.700}",
        "selection": "rgba(154, 58, 12, 0.18)",

        "scrollbar": "{palette.iron.150}",
        "scrollbar-hover": "{palette.iron.250}"
      },

      "status": {
        "running": "{palette.iron.900}",
        "running-style": "solid",
        "running-width": "{global.border.thick}",

        "completed": "{palette.iron.600}",
        "completed-style": "solid",
        "completed-width": "{global.border.hair}",

        "verify": "{palette.iron.500}",
        "verify-style": "solid",
        "verify-width": "{global.border.hair}",

        "review": "{palette.iron.450}",
        "review-style": "dashed",
        "review-width": "{global.border.hair}",

        "waiting": "{palette.iron.350}",
        "waiting-style": "dashed",
        "waiting-width": "{global.border.hair}",

        "blocked": "{palette.iron.300}",
        "blocked-style": "dotted",
        "blocked-width": "{global.border.hair}",

        "failed": "{palette.iron.1000}",
        "failed-style": "solid",
        "failed-width": "{global.border.thick}",

        "previewing": "{palette.iron.500}",
        "previewing-style": "dashed",
        "previewing-width": "{global.border.hair}",

        "internal": "{palette.iron.300}",
        "internal-style": "dotted",
        "internal-width": "{global.border.hair}"
      },

      "group": {
        "control": "{palette.iron.900}",
        "context": "{palette.iron.700}",
        "planning": "{palette.iron.600}",
        "domain": "{palette.iron.500}",
        "execution": "{palette.iron.450}",
        "review": "{palette.iron.350}",
        "memory": "{palette.iron.300}"
      },

      "shadow": {
        "sm": "0 1px 2px rgba(16, 20, 24, 0.07)",
        "md": "0 4px 14px rgba(16, 20, 24, 0.09)",
        "lg": "0 18px 44px rgba(16, 20, 24, 0.13)",
        "inset": "inset 0 1px 0 rgba(255, 255, 255, 0.8)",
        "focus-ring": "0 0 0 2px #FFFFFF, 0 0 0 4px rgba(154, 58, 12, 0.8)"
      }
    }
  }
}
